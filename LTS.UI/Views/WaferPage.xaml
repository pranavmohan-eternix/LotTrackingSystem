<Page x:Class="LTS.UI.Views.WaferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F2F5">

    <Page.Resources>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Blue table header -->
        <Style x:Key="BlueGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Table cell -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="16,0"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Primary blue button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4FBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete red button -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28,20,28,40">

            <!-- ── PAGE HEADER ── -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,22">
                <Border Width="48" Height="48"
                        CornerRadius="10"
                        Background="#2563EB"
                        Margin="0,0,14,0">
                    <TextBlock Text="W"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wafer Management"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                    <TextBlock Text="Add and manage your wafers"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── ADD NEW WAFER CARD ── -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20"
                    Margin="0,0,0,24">
                <StackPanel>

                    <TextBlock Text="Add New Wafer"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Fill in the details below"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,0,0,20"/>

                    <!-- Serial No + Supplier side by side -->
                    <Grid Margin="0,0,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Supplier -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Supplier"
                   Style="{StaticResource FieldLabel}"/>

                            <ComboBox Style="{StaticResource FormComboBox}"
                  ItemsSource="{Binding Suppliers}"
                  SelectedItem="{Binding SelectedSupplier}"
                  DisplayMemberPath="SupplierName"/>
                        </StackPanel>

                        <!-- Prefix -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Prefix"
                   Style="{StaticResource FieldLabel}"/>

                            <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding Prefix}"/>
                        </StackPanel>

                        <!-- Count -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Count"
                   Style="{StaticResource FieldLabel}"/>

                            <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding GenerateCount}"/>
                        </StackPanel>

                    </Grid>
                    <Button Content="Generate Wafers"
                            Width="170"
                            Height="42"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Margin="0,20,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateWafersCommand}"/>


                </StackPanel>
            </Border>

            <!-- ── WAFER LIST ── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Wafer List"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>

                <!-- Filter checkbox — right aligned -->
                <CheckBox Grid.Column="1"
                          Content="Show Unallocated Only"
                          IsChecked="{Binding ShowUnallocatedOnly}"
                          FontSize="13"
                          Foreground="#374151"
                          VerticalAlignment="Center"/>
            </Grid>

            <DataGrid ItemsSource="{Binding Wafers}"
                      SelectedItem="{Binding SelectedWafer}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="48"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      ColumnHeaderStyle="{StaticResource BlueGridHeader}"
                      CellStyle="{StaticResource GridCell}"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="48"/>

                        <Style.Triggers>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- ID -->
                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding WaferId}"
                        Width="70"/>

                    <!-- SERIAL -->
                    <DataGridTextColumn
                        Header="Wafer Serial"
                        Binding="{Binding WaferSerialNo}"
                        Width="1.5*"/>

                    <!-- SUPPLIER -->
                    <DataGridTextColumn
                        Header="Supplier"
                        Binding="{Binding SupplierName}"
                        Width="1.2*"/>

                    <!-- LOT ID -->
                    <DataGridTextColumn
                        Header="Lot ID"
                        Binding="{Binding LotId}"
                        Width="*"/>

                    <!-- STATUS — dot + colored text -->
                    <!-- STATUS — dot + colored text -->
                    <DataGridTemplateColumn Header="Status" Width="130">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource BlueGridHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Margin="0,0,7,0"
                         VerticalAlignment="Center"
                         Fill="#9CA3AF"/>
                                    <TextBlock x:Name="StatusText"
                           Text="{Binding WaferStatus}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"/>
                                </StackPanel>
                                <DataTemplate.Triggers>

                                    <!-- Unallocated — amber -->
                                    <DataTrigger Binding="{Binding WaferStatus}" Value="Unallocated">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#D97706"/>
                                    </DataTrigger>

                                    <!-- Allocated — blue -->
                                    <DataTrigger Binding="{Binding WaferStatus}" Value="Allocated">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#2563EB"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>

                                    <!-- Queued — orange -->
                                    <DataTrigger Binding="{Binding WaferStatus}" Value="Queued">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#EA580C"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#EA580C"/>
                                    </DataTrigger>

                                    <!-- Processing — green -->
                                    <DataTrigger Binding="{Binding WaferStatus}" Value="Processing">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#16A34A"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#16A34A"/>
                                    </DataTrigger>

                                    <!-- Completed — gray -->
                                    <DataTrigger Binding="{Binding WaferStatus}" Value="Completed">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#6B7280"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>

                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CREATED -->
                    <DataGridTextColumn
                        Header="Created"
                        Binding="{Binding CreatedOn}"
                        Width="1.2*"/>

                    <!-- DELETE -->
                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Width="72"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DeleteButton}"
                                        Command="{Binding DataContext.DeleteWaferCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</Page>
