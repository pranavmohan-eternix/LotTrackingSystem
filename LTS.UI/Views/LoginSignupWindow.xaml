<Window x:Class="LTS.UI.Views.LoginSignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LTS.UI.Helpers"
        Title="LTS Login"
        Height="680"
        Width="1050"
        MinHeight="580"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowState="Normal">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Form PasswordBox -->
        <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Eye toggle button -->
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab toggle button -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4FBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left dark panel -->
            <ColumnDefinition Width="400"/>
            <!-- Right form panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--LEFT PANEL — dark navy with card style-->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Decorative circle top-right -->
            <Ellipse Width="260" Height="260"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-80,-80,0"
                     Opacity="0.07">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#2563EB"/>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Decorative circle bottom-left -->
            <Ellipse Width="200" Height="200"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-60,0,0,-60"
                     Opacity="0.07">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#2563EB"/>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center"
                        Margin="44,0,44,0">

                <!-- Blue logo tile -->
                <Border Width="68" Height="68"
                        CornerRadius="16"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#1D4FBD" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="LTS"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Lot Tracking System"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Semiconductor Process Management"
                           FontSize="13"
                           Foreground="#94A3B8"
                           Margin="0,0,0,40"/>

                <!-- Divider -->
                <Rectangle Height="1"
                           Fill="#FFFFFF14"
                           Margin="0,0,0,36"/> <!--left,top,right,bottom (next one 36 bottom)-->

                <!-- Feature list -->
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="#1E3A6E"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="📦"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Lot &amp; Wafer Tracking"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F1F5F9"/>
                            <TextBlock Text="Real-time lot movement visibility"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="#1E3A6E"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="🏭"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Process Stations"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F1F5F9"/>
                            <TextBlock Text="Manage carriers and suppliers"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="#1E3A6E"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="📋"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Full Audit Logs"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F1F5F9"/>
                            <TextBlock Text="Complete history and event logs"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!-- Bottom version tag -->
                <TextBlock Text="v1.0 · LTS Platform"
                           FontSize="11"
                           Foreground="#334155"
                           Margin="0,48,0,0"/>

            </StackPanel>
        </Grid>

        <!--RIGHT PANEL — white form -->
        <Grid Grid.Column="1" Background="#F8FAFC">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="360">

                <!-- Heading -->
                <TextBlock Text="{Binding CurrentSection}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Enter your credentials to continue"
                           FontSize="13"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Login / Sign Up segmented toggle -->
                <Border Background="#E5E7EB"
                        CornerRadius="10"
                        Padding="4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Login"
                                Style="{StaticResource TabButton}"
                                Background="{Binding LoginButtonColor}"
                                Foreground="White"
                                Command="{Binding ShowLoginCommand}"/>
                        <Button Content="Sign Up"
                                Style="{StaticResource TabButton}"
                                Background="{Binding SignupButtonColor}"
                                Foreground="White"
                                Margin="4,0,0,0"
                                Command="{Binding ShowSignupCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ── LOGIN SECTION ── -->
                <StackPanel Visibility="{Binding IsLogin, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>

                    <!-- Password field with visible eye -->
                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Height="44"
                            Margin="0,0,0,24">
                        <Grid>
                            <PasswordBox x:Name="LoginPasswordBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="14,0,46,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"/>
                            <TextBox x:Name="LoginPasswordText"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="14,0,46,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     Visibility="Collapsed"/>
                            <!-- Eye button — dark icon, always visible -->
                            <Button Style="{StaticResource EyeButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Click="ToggleLoginPassword">
                                <TextBlock Text="👁"
                                           FontSize="17"
                                           Foreground="#374151"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Content="Login"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}"/>

                </StackPanel>

                <!-- ── SIGNUP SECTION ── -->
                <StackPanel Visibility="{Binding IsSignup, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SignupUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>

                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Height="44"
                            Margin="0,0,0,16">
                        <Grid>
                            <PasswordBox x:Name="SignupPasswordBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="14,0,46,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"/>
                            <TextBox x:Name="SignupPasswordText"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="14,0,46,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     Visibility="Collapsed"/>
                            <Button Style="{StaticResource EyeButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Click="ToggleSignupPassword">
                                <TextBlock Text="👁"
                                           FontSize="17"
                                           Foreground="#374151"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding Role}"
                              Height="44"
                              FontSize="14"
                              BorderBrush="#D1D5DB"
                              BorderThickness="1"
                              Margin="0,0,0,24">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Operator"/>
                    </ComboBox>
                
                    <Button Content="Create Account"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignupCommand}"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
