<Page x:Class="LTS.UI.Views.LotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F2F5">

    <Page.Resources>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Blue table header — matches Carriers page exactly -->
        <Style x:Key="BlueGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Table cell -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="16,0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary blue button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4FBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start button with disable triggers -->
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Delete red button -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28,20,28,40">

            <!-- ── PAGE HEADER — matches Carrier Management style ── -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,22">
                <Border Width="48" Height="48"
                        CornerRadius="10"
                        Background="#2563EB"
                        Margin="0,0,14,0">
                    <TextBlock Text="L"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lot Management"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                    <TextBlock Text="Create and manage your lots"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── ADD NEW LOT CARD — matches Add New Carrier card ── -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20"
                    Margin="0,0,0,24">
                <StackPanel>

                    <TextBlock Text="Add New Lot"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Fill in the details below"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,0,0,20"/>

                    <!-- Lot Code + Carrier row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lot Code"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding LotCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Carrier"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding Carriers}"
                                      SelectedItem="{Binding SelectedCarrier}"
                                      DisplayMemberPath="CarrierCode"/>
                        </StackPanel>
                    </Grid>

                    <!-- Available Wafers -->
                    <Grid Margin="0,8,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Available Wafers"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"/> 

                        <Button Grid.Column="1"
                                Content="Fill Wafers"
                                Width="130"
                                Height="34"
                                Margin="0,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding FillWafersCommand}"/> 

                    </Grid>

                    <DataGrid ItemsSource="{Binding AvailableWafers}"
                              AutoGenerateColumns="False"
                              Height="200"
                              CanUserAddRows="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              RowHeight="40"
                              BorderThickness="1"
                              BorderBrush="#E5E7EB"
                              ColumnHeaderStyle="{StaticResource BlueGridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Select" Width="70">

                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                    BasedOn="{StaticResource BlueGridHeader}"/>
                                </DataGridTemplateColumn.HeaderStyle>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"/>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Wafer ID"
                                Binding="{Binding WaferId}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Serial No"
                                Binding="{Binding WaferSerialNo}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Supplier"
                                Binding="{Binding SupplierName}"
                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add Lot button — left aligned like Add Carrier -->
                    <Button Content="Add Lot"
                            Width="140"
                            Height="42"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Margin="0,20,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddLotCommand}"/>

                </StackPanel>
            </Border>

            <!-- ── LOT LIST — matches Carrier List section ── -->
            <TextBlock Text="Lot List"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,12"/>

            <DataGrid ItemsSource="{Binding Lots}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="48"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      ColumnHeaderStyle="{StaticResource BlueGridHeader}"
                      CellStyle="{StaticResource GridCell}"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFBFC">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Lot"
                        Binding="{Binding LotCode}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Carrier"
                        Binding="{Binding CarrierCode}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Wafers"
                        Binding="{Binding WaferCount}"
                        Width="80"/>

                    <DataGridTextColumn
                        Header="Station"
                        Binding="{Binding CurrentStation}"
                        Width="100"/>

                    <!-- STATUS — dot + colored text exactly like Carriers page -->
                    <DataGridTemplateColumn Header="Status" Width="130">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot"
                                             Width="8" Height="8"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="#9CA3AF"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding Status}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="#9CA3AF"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#16A34A"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#2563EB"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Queued">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="StatusDot"  Property="Fill"      Value="#6B7280"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- START -->
                    <DataGridTemplateColumn Header="Start" Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Start"
                                        Width="72"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource StartButton}"
                                        Command="{Binding DataContext.StartLotCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- DELETE -->
                    <DataGridTemplateColumn Header="Delete" Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Width="72"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DeleteButton}"
                                        Command="{Binding DataContext.DeleteLotCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</Page>
