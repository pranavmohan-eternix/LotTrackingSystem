<Page x:Class="LTS.UI.Views.SupplierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="28">

                <!-- PAGE HEADER -->

                <Grid Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="46"
                            Height="46"
                            Background="#2563EB"
                            CornerRadius="10"
                            Margin="0,0,14,0">

                        <TextBlock Text="S"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Supplier Management"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Add and manage your supplier directory"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- FORM CARD -->

                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Add New Supplier"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="Fill in the details below"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,20"/>

                        <Rectangle Height="1"
                                   Fill="#F1F5F9"
                                   Margin="0,0,0,20"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SUPPLIER NAME -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Supplier Name"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="40"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         Background="#F8FAFC"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1"/>

                            </StackPanel>

                            <!-- CONTACT PERSON -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Contact Person"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                         Height="40"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         Background="#F8FAFC"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1"/>

                            </StackPanel>

                            <!-- EMAIL -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Email Address"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Height="40"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         Background="#F8FAFC"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1"/>

                            </StackPanel>

                        </Grid>

                        <!-- SAVE BUTTON -->

                        <Button Content="Save Supplier"
                                Height="42"
                                Width="180"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                BorderThickness="0"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Margin="0,20,0,0"
                                Command="{Binding SaveSupplierCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="bg"
                                            Background="#2563EB"
                                            CornerRadius="8">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#1D4ED8"/>

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#1E40AF"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Border>

                <!-- TABLE CARD -->

                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="24">

                    <StackPanel>

                        <TextBlock Text="Supplier List"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding Suppliers.Count, StringFormat='{}{0} suppliers registered'}"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,18"/>

                        <DataGrid ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  AutoGenerateColumns="False"
                                  RowHeight="52"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="False"
                                  CanUserReorderColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFBFC"
                                  AlternationCount="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single">

                            <!-- ROW STYLE -->

                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#EFF6FF"/>

                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#DBEAFE"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </DataGrid.RowStyle>

                            <!-- HEADER STYLE -->

                            <DataGrid.ColumnHeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#2563EB"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="Height"
                                            Value="44"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="DataGridColumnHeader">

                                                <Border Background="#2563EB"
                                                        Padding="10,0">

                                                    <TextBlock Text="{TemplateBinding Content}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </DataGrid.ColumnHeaderStyle>

                            <!-- CELL STYLE -->

                            <DataGrid.CellStyle>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="Padding"
                                            Value="10,0"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="Foreground"
                                            Value="#1E293B"/>

                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextBlock.TextAlignment"
                                            Value="Center"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="Transparent"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </DataGrid.CellStyle>

                            <!-- COLUMNS -->

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding SupplierId}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Supplier Name"
                                                    Binding="{Binding SupplierName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Contact Person"
                                                    Binding="{Binding ContactPerson}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="1.5*"/>

                                <DataGridTextColumn Header="Added Date"
                                                    Binding="{Binding AddedDate, StringFormat=dd-MM-yyyy}"
                                                    Width="140"/>

                                <!-- DELETE BUTTON -->

                                <DataGridTemplateColumn Header="Action"
                                                        Width="120">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Width="82"
                                                    Height="30"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteSupplierCommand,
                                                              RelativeSource={RelativeSource AncestorType=Page}}">

                                                <Button.Template>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border x:Name="bd"
                                                                Background="Transparent"
                                                                BorderBrush="#CBD5E1"
                                                                BorderThickness="1"
                                                                CornerRadius="6">

                                                            <TextBlock x:Name="txt"
                                                                       Text="Delete"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#64748B"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">

                                                                <Setter TargetName="bd"
                                                                        Property="Background"
                                                                        Value="#FEF2F2"/>

                                                                <Setter TargetName="bd"
                                                                        Property="BorderBrush"
                                                                        Value="#FCA5A5"/>

                                                                <Setter TargetName="txt"
                                                                        Property="Foreground"
                                                                        Value="#DC2626"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Button.Template>

                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>