<Page x:Class="LTS.UI.Views.LotHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F2F5">

    <Page.Resources>

        <!-- Blue table header -->
        <Style x:Key="BlueGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Table cell -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="16,0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28,20,28,40">

            <!-- ── PAGE HEADER ── -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,22">
                <Border Width="48" Height="48"
                        CornerRadius="10"
                        Background="#2563EB"
                        Margin="0,0,14,0">
                    <TextBlock Text="H"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lot History"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                    <TextBlock Text="Track all lot movements and actions"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── HISTORY LIST ── -->
            <TextBlock Text="History List"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,12"/>

            <DataGrid ItemsSource="{Binding HistoryList}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="48"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      ColumnHeaderStyle="{StaticResource BlueGridHeader}"
                      CellStyle="{StaticResource GridCell}"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFBFC">

                <DataGrid.Columns>

                    <!-- HISTORY ID -->
                    <DataGridTextColumn
                        Header="History ID"
                        Binding="{Binding HistoryId}"
                        Width="*"/>

                    <!-- LOT CODE -->
                    <DataGridTextColumn
                        Header="Lot Code"
                        Binding="{Binding LotCode}"
                        Width="1.2*"/>

                    <!-- ACTION -->
                    <DataGridTextColumn
                        Header="Action"
                        Binding="{Binding Action}"
                        Width="1.4*"/>

                    <!-- FROM -->
                    <DataGridTextColumn
                        Header="From"
                        Binding="{Binding FromStation}"
                        Width="0.8*"/>

                    <!-- TO -->
                    <DataGridTextColumn
                        Header="To"
                        Binding="{Binding ToStation}"
                        Width="0.8*"/>

                    <!-- STATUS — dot + colored text -->
                    <DataGridTemplateColumn Header="Status" Width="1.3*">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot"
                                             Width="8" Height="8"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="#9CA3AF"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding Status}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="#9CA3AF"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#16A34A"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Idle">
                                        <Setter TargetName="StatusDot"  Property="Fill"       Value="#EF4444"/>
                                        <Setter TargetName="StatusText" Property="Foreground"  Value="#EF4444"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TIMESTAMP -->
                    <DataGridTextColumn
                        Header="Timestamp"
                        Binding="{Binding Timestamp}"
                        Width="2*"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</Page>
