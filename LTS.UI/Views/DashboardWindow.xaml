<Window x:Class="LTS.UI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LTS — Lot Tracking System"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>

        <!-- ══════════════════════════════════ -->
        <!--  SIDEBAR NAV BUTTON               -->
        <!-- ══════════════════════════════════ -->

        <Style x:Key="NavButtonStyle"
               TargetType="Button">
            <Setter Property="Height"         Value="44"/>
            <Setter Property="Margin"         Value="0,2"/>
            <Setter Property="Foreground"     Value="#94A3B8"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="Medium"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="14,0">
                            <DockPanel>
                                <!-- ACTIVE INDICATOR BAR -->
                                <Border x:Name="ActiveBar"
                                        Width="3"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        DockPanel.Dock="Left"
                                        Margin="0,10,12,10"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#263548"/>
                                <Setter TargetName="ActiveBar" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LOGOUT BUTTON STYLE -->
        <Style x:Key="LogoutButtonStyle"
               TargetType="Button">
            <Setter Property="Height"         Value="44"/>
            <Setter Property="Foreground"     Value="#64748B"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LogoutBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LogoutBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LogoutBorder" Property="Background" Value="#2D1F1F"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <!-- SIDEBAR -->
            <ColumnDefinition Width="230"/>
            <!-- CONTENT -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  SIDEBAR                           -->
        <!-- ══════════════════════════════════ -->

        <Border Grid.Column="0"
                Background="#0F172A">

            <!-- SUBTLE RIGHT BORDER -->
            <Border BorderBrush="#1E293B"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO AREA -->
                    <Border Grid.Row="0"
                            Padding="20,24,20,20"
                            BorderBrush="#1E293B"
                            BorderThickness="0,0,0,1">
                        <StackPanel>

                            <!-- LOGO MARK + TEXT -->
                            <DockPanel Margin="0,0,0,6">
                                <Border Background="#2563EB"
                                        CornerRadius="8"
                                        Width="36"
                                        Height="36"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="L"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LTS"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="Lot Tracking System"
                                               FontSize="10"
                                               Foreground="#475569"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                    <!-- NAV MENU -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="12,16,12,0">
                        <StackPanel>

                            <!-- SECTION LABEL -->
                            <TextBlock Text="MAIN MENU"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Margin="14,0,0,8"
                                       />

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenDashboardCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬛"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="#3B82F6"/>
                                    <TextBlock Text="Dashboard"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenSupplierCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Suppliers"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenProcessLocationCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Process Locations"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenCarrierCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Carriers"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- SECTION LABEL -->
                            <TextBlock Text="TRACKING"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Margin="14,16,0,8"
                                       />

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenLotCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Lots"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenWaferCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Wafers"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenHistoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◷"
                                               FontSize="13"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Lot History"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding OpenLogCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≡"
                                               FontSize="15"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Logs"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- LOGOUT -->
                    <Border Grid.Row="2"
                            BorderBrush="#1E293B"
                            BorderThickness="0,1,0,0"
                            Padding="12,12">

                        <!-- USER CARD -->
                        <Border Background="#1E293B"
                                CornerRadius="10"
                                Padding="12,10">
                            <DockPanel>

                                <!-- AVATAR -->
                                <Border Width="34"
                                        Height="34"
                                        Background="#2563EB"
                                        CornerRadius="17"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ProfileLetter}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- LOGOUT BTN -->
                                <Button Style="{StaticResource LogoutButtonStyle}"
                                        Click="Logout_Click"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock Text="Sign out"
                                                       FontSize="10"
                                                       Foreground="#475569"/>
                                        </StackPanel>
                                        <TextBlock Text="↩"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="#475569"/>
                                    </StackPanel>
                                </Button>

                            </DockPanel>
                        </Border>

                    </Border>

                </Grid>
            </Border>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  RIGHT CONTENT AREA               -->
        <!-- ══════════════════════════════════ -->

        <Grid Grid.Column="1"
              Background="#F1F5F9">

            <Grid.RowDefinitions>
                <!-- TOP BAR -->
                <RowDefinition Height="Auto"/>
                <!-- PAGE CONTENT -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                    Height="64">
                <DockPanel LastChildFill="False"
                           VerticalAlignment="Center">

                    <!-- PAGE TITLE -->
                    <StackPanel DockPanel.Dock="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>

                    <!-- RIGHT: USER INFO -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Username}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"/>

                        <Border Width="38"
                                Height="38"
                                Background="#2563EB"
                                CornerRadius="19"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileLetter}"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- PAGE CONTENT FRAME -->
            <Frame Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Content="{Binding CurrentPage}"
                   Background="#F1F5F9"/>

        </Grid>

    </Grid>

</Window>
