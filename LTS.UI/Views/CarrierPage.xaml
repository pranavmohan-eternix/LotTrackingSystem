<Page x:Class="LTS.UI.Views.CarrierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9">

    <Page.Resources>

        <Style x:Key="HeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#2563EB"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Height"                     Value="46"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="CellStyle"
               TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="12,0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowStyle"
               TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Foreground"          Value="#374151"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24,20,24,28">

            <!-- PAGE HEADER -->

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,22">

                <Border Width="48" Height="48"
                        Background="#2563EB"
                        CornerRadius="10"
                        Margin="0,0,14,0">
                    <TextBlock Text="C"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Carrier Management"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>
                    <TextBlock Text="Add and manage your carriers"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,2,0,0"/>
                </StackPanel>

            </StackPanel>

            <!-- FORM CARD -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="24,20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Add New Carrier"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Fill in the details below"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,2,0,18"/>

                    <!-- TWO FIELDS SIDE BY SIDE -->

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Carrier Code"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CarrierCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Carrier Capacity"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>

                    </Grid>

                    <!-- BUTTON -->

                    <Button Content="Add Carrier"
                            Command="{Binding AddCarrierCommand}"
                            Height="36"
                            Width="130"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#2563EB"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Height="36"
                                        Padding="16,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

            </Border>

            <!-- TABLE TITLE -->

            <TextBlock Text="Carrier List"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,10"/>

            <!-- TABLE -->

            <Border Background="White"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <DataGrid ItemsSource="{Binding Carriers}"
                          SelectedItem="{Binding SelectedCarrier}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          AlternationCount="2"
                          Background="White"
                          ColumnHeaderStyle="{StaticResource HeaderStyle}"
                          CellStyle="{StaticResource CellStyle}"
                          RowStyle="{StaticResource RowStyle}">

                    <DataGrid.Columns>

                        <!-- ID -->
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding CarrierId}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CenterText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- CARRIER CODE -->
                        <DataGridTextColumn Header="Carrier Code"
                                            Binding="{Binding CarrierCode}"
                                            Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CenterText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- STATUS -->
                        <DataGridTemplateColumn Header="Status"
                                                Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="BadgeBorder"
                                            CornerRadius="20"
                                            Padding="9,3"
                                            HorizontalAlignment="Center"
                                            Background="#F0FDF4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="BadgeDot"
                                                     Width="5" Height="5"
                                                     Fill="#22C55E"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"/>
                                            <TextBlock x:Name="BadgeText"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#15803D"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FFF7ED"/>
                                            <Setter TargetName="BadgeDot"    Property="Fill"       Value="#F97316"/>
                                            <Setter TargetName="BadgeText"   Property="Foreground" Value="#C2410C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- CAPACITY -->
                        <DataGridTextColumn Header="Capacity"
                                            Binding="{Binding Capacity}"
                                            Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CenterText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- CURRENT LOCATION -->
                        <DataGridTextColumn Header="Current Location"
                                            Binding="{Binding CurrentLocationText}"
                                            Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CenterText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- CREATED DATE -->
                        <DataGridTextColumn Header="Created Date"
                                            Binding="{Binding CreatedDate}"
                                            Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CenterText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>
