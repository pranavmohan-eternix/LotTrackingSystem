<Page x:Class="LTS.UI.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F2F5">

    <Page.Resources>

        <!-- Blue table header -->
        <Style x:Key="BlueGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Table cell -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="16,0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row style — subtle tinted background per log level -->
        <Style x:Key="LogRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="INFO">
                    <Setter Property="Background" Value="#F0FDF4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Background" Value="#FFFBEB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Background" Value="#FFF1F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28,20,28,40">

            <!-- ── PAGE HEADER ── -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,22">
                <Border Width="48" Height="48"
                        CornerRadius="10"
                        Background="#2563EB"
                        Margin="0,0,14,0">
                    <TextBlock Text="L"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Application Logs"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                    <TextBlock Text="Monitor system events and errors"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── LEGEND ROW ── -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">

                <!-- INFO -->
                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="#16A34A"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="INFO"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#16A34A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- WARN -->
                <Border Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="#D97706"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="WARN"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D97706"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ERROR -->
                <Border Background="#FFF1F2"
                        BorderBrush="#FECDD3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="#DC2626"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="ERROR"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#DC2626"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── LOG TABLE ── -->
            <DataGrid ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="44"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      ColumnHeaderStyle="{StaticResource BlueGridHeader}"
                      CellStyle="{StaticResource GridCell}"
                      RowStyle="{StaticResource LogRow}"
                      Background="White">

                <DataGrid.Columns>

                    <!-- TIMESTAMP -->
                    <DataGridTextColumn
                        Header="Timestamp"
                        Binding="{Binding Timestamp}"
                        Width="220"/>

                    <!-- LEVEL — dot + colored text -->
                    <DataGridTemplateColumn Header="Level" Width="110">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource BlueGridHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="LevelDot"
                                             Width="8" Height="8"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="#9CA3AF"/>
                                    <TextBlock x:Name="LevelText"
                                               Text="{Binding Level}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#9CA3AF"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                        <Setter TargetName="LevelDot"  Property="Fill"       Value="#16A34A"/>
                                        <Setter TargetName="LevelText" Property="Foreground"  Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                        <Setter TargetName="LevelDot"  Property="Fill"       Value="#D97706"/>
                                        <Setter TargetName="LevelText" Property="Foreground"  Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                        <Setter TargetName="LevelDot"  Property="Fill"       Value="#DC2626"/>
                                        <Setter TargetName="LevelText" Property="Foreground"  Value="#DC2626"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- MESSAGE -->
                    <DataGridTextColumn
                        Header="Message"
                        Binding="{Binding Message}"
                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</Page>
