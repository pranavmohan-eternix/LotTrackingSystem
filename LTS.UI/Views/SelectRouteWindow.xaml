<Window x:Class="LTS.UI.Views.SelectRouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Route"
        Height="450"
        Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- TITLE -->

        <TextBlock Text="Select Stations"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- STATION LIST -->

        <!-- STATION LIST -->

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Stations}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="White"
                        Margin="0,0,0,10"
                        Padding="12"
                        CornerRadius="8">

                            <CheckBox Content="{Binding StationName}"
                              IsChecked="{Binding IsSelected}"
                              FontSize="16"/>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- BUTTON -->

        <Button Grid.Row="2"
                Content="Start Process"
                Height="42"
                Margin="0,20,0,0"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                FontSize="15"
                Command="{Binding StartProcessCommand}"/>

    </Grid>

</Window>