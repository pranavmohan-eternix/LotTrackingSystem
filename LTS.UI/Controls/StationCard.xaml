<UserControl x:Class="LTS.UI.Controls.StationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Cursor="Hand">

    <UserControl.Resources>

        <!-- 1. LOAD: fade in + slide up -->
        <Storyboard x:Key="LoadAnim">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.45"/>
            <DoubleAnimation
                Storyboard.TargetName="SlideTransform"
                Storyboard.TargetProperty="Y"
                From="18" To="0"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 2. HOVER IN: scale up -->
        <Storyboard x:Key="HoverIn">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.04" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.04" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 3. HOVER OUT: scale back -->
        <Storyboard x:Key="HoverOut">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 4. OCCUPIED PULSE: orange border + shadow + dot -->
        <Storyboard x:Key="OccupiedPulse"
                    RepeatBehavior="Forever">
            <ColorAnimation
                Storyboard.TargetName="OccBorderBrush"
                Storyboard.TargetProperty="Color"
                From="#F97316" To="#FED7AA"
                Duration="0:0:1"
                AutoReverse="True"/>
            <DoubleAnimation
                Storyboard.TargetName="OccShadow"
                Storyboard.TargetProperty="BlurRadius"
                From="6" To="20"
                Duration="0:0:1"
                AutoReverse="True"/>
            <DoubleAnimation
                Storyboard.TargetName="OccShadow"
                Storyboard.TargetProperty="Opacity"
                From="0.6" To="0.1"
                Duration="0:0:1"
                AutoReverse="True"/>
            <DoubleAnimation
                Storyboard.TargetName="OccDot"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0.1"
                Duration="0:0:0.85"
                AutoReverse="True"/>
        </Storyboard>

    </UserControl.Resources>

    <!-- LOAD + HOVER triggers -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadAnim}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="UserControl.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="UserControl.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="RootGrid" Opacity="0">

        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- ═══════════════════════ -->
        <!--  AVAILABLE CARD        -->
        <!-- ═══════════════════════ -->
        <Border x:Name="AvailableCard"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="14,13"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Color="#CBD5E1" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>

                <TextBlock Text="{Binding ElementName=Root, Path=StationName}"
                           FontSize="17" FontWeight="Bold"
                           Foreground="#1E293B" Margin="0,0,0,6"/>

                <!-- GREEN AVAILABLE BADGE -->
                <Border Background="#F0FDF4" CornerRadius="20"
                        Padding="8,3" HorizontalAlignment="Left"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#22C55E"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Available" FontSize="11"
                                   FontWeight="Bold" Foreground="#15803D"/>
                    </StackPanel>
                </Border>

                <Separator Background="#E2E8F0" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Lot" Grid.Row="0" Grid.Column="0"
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                    <TextBlock Text="—" Grid.Row="0" Grid.Column="1"
                               FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                    <TextBlock Text="Wafers" Grid.Row="2" Grid.Column="0"
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                    <TextBlock Text="—" Grid.Row="2" Grid.Column="1"
                               FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════ -->
        <!--  OCCUPIED CARD         -->
        <!-- ═══════════════════════ -->
        <Border x:Name="OccupiedCard"
                Background="#FFF7ED"
                CornerRadius="12"
                BorderThickness="2"
                Padding="14,13"
                Visibility="Collapsed">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="OccBorderBrush" Color="#F97316"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="OccShadow"
                                  BlurRadius="6" ShadowDepth="0"
                                  Color="#F97316" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>

                <DockPanel Margin="0,0,0,6">
                    <Ellipse x:Name="OccDot"
                             Width="8" Height="8" Fill="#F97316"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right"/>
                    <TextBlock Text="{Binding ElementName=Root, Path=StationName}"
                               FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                </DockPanel>

                <!-- ORANGE OCCUPIED BADGE -->
                <Border Background="#FFEDD5" CornerRadius="20"
                        Padding="8,3" HorizontalAlignment="Left"
                        Margin="0,0,0,10">
                    <TextBlock Text="● Occupied" FontSize="11"
                               FontWeight="Bold" Foreground="#C2410C"/>
                </Border>

                <Separator Background="#FED7AA" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Lot" Grid.Row="0" Grid.Column="0"
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ElementName=Root, Path=CurrentLot}"
                               Grid.Row="0" Grid.Column="1"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#1E293B" TextWrapping="Wrap"/>
                    <TextBlock Text="Wafers" Grid.Row="2" Grid.Column="0"
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ElementName=Root, Path=WaferCount}"
                               Grid.Row="2" Grid.Column="1"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
