<Application x:Class="LTS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <ResourceDictionary>

            <!-- COLORS -->

            <Color x:Key="BackgroundColor">
                #F8FAFC
            </Color>

            <Color x:Key="CardColor">
                #FFFFFF
            </Color>

            <Color x:Key="SidebarColor">
                #0F172A
            </Color>

            <Color x:Key="AccentBlue">
                #2563EB
            </Color>

            <Color x:Key="BorderColor">
                #E2E8F0
            </Color>

            <Color x:Key="TextDark">
                #0F172A
            </Color>

            <Color x:Key="TextLight">
                #64748B
            </Color>

            <!-- BRUSHES -->

            <SolidColorBrush x:Key="BackgroundBrush"
                             Color="{StaticResource BackgroundColor}"/>

            <SolidColorBrush x:Key="CardBrush"
                             Color="{StaticResource CardColor}"/>

            <SolidColorBrush x:Key="SidebarBrush"
                             Color="{StaticResource SidebarColor}"/>

            <SolidColorBrush x:Key="AccentBrush"
                             Color="{StaticResource AccentBlue}"/>

            <SolidColorBrush x:Key="BorderBrushCustom"
                             Color="{StaticResource BorderColor}"/>

            <SolidColorBrush x:Key="DarkTextBrush"
                             Color="{StaticResource TextDark}"/>

            <SolidColorBrush x:Key="LightTextBrush"
                             Color="{StaticResource TextLight}"/>

            <!-- WINDOW -->

            <Style TargetType="Window">

                <Setter Property="Background"
                        Value="{StaticResource BackgroundBrush}"/>

                <Setter Property="FontFamily"
                        Value="Segoe UI"/>

                <Setter Property="Foreground"
                        Value="{StaticResource DarkTextBrush}"/>

            </Style>

            <!-- BUTTON -->

            <Style TargetType="Button">

                <Setter Property="Background"
                        Value="{StaticResource AccentBrush}"/>

                <Setter Property="Foreground"
                        Value="White"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="Padding"
                        Value="14,8"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="FontWeight"
                        Value="SemiBold"/>

                <Setter Property="Cursor"
                        Value="Hand"/>

                <Setter Property="Margin"
                        Value="4"/>

            </Style>

            <!-- TEXTBOX -->

            <Style TargetType="TextBox">

                <Setter Property="Height"
                        Value="38"/>

                <Setter Property="Padding"
                        Value="10,4"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="Background"
                        Value="White"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="BorderBrush"
                        Value="#CBD5E1"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

            </Style>

            <!-- PASSWORD BOX -->

            <Style TargetType="PasswordBox">

                <Setter Property="Height"
                        Value="38"/>

                <Setter Property="Padding"
                        Value="10,4"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="Background"
                        Value="White"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="BorderBrush"
                        Value="#CBD5E1"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

            </Style>

            <!-- COMBOBOX -->

            <Style TargetType="ComboBox">

                <Setter Property="Height"
                        Value="38"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="Background"
                        Value="White"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="BorderBrush"
                        Value="#CBD5E1"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

            </Style>

            <!-- DATAGRID -->

            <Style TargetType="DataGrid">

                <Setter Property="Background"
                        Value="White"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="BorderBrush"
                        Value="#E2E8F0"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

                <Setter Property="RowBackground"
                        Value="White"/>

                <Setter Property="AlternatingRowBackground"
                        Value="#F8FAFC"/>

                <Setter Property="GridLinesVisibility"
                        Value="Horizontal"/>

                <Setter Property="HorizontalGridLinesBrush"
                        Value="#E2E8F0"/>

                <Setter Property="VerticalGridLinesBrush"
                        Value="#E2E8F0"/>

                <Setter Property="HeadersVisibility"
                        Value="Column"/>

                <Setter Property="RowHeight"
                        Value="38"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <!-- HEADER STYLE -->

                <Setter Property="ColumnHeaderStyle">

                    <Setter.Value>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#2563EB"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Setter Property="FontWeight"
                                    Value="Bold"/>

                            <Setter Property="FontSize"
                                    Value="14"/>

                            <Setter Property="Height"
                                    Value="42"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Setter Property="Padding"
                                    Value="10,0"/>

                        </Style>

                    </Setter.Value>

                </Setter>

            </Style>

            <!-- DATAGRID ROW -->

            <Style TargetType="DataGridRow">

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="Background"
                        Value="White"/>

            </Style>

            <!-- CHECKBOX -->

            <Style TargetType="CheckBox">

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

                <Setter Property="Margin"
                        Value="4"/>

            </Style>

            <!-- GROUPBOX -->

            <Style TargetType="GroupBox">

                <Setter Property="Margin"
                        Value="10"/>

                <Setter Property="Padding"
                        Value="14"/>

                <Setter Property="FontSize"
                        Value="16"/>

                <Setter Property="FontWeight"
                        Value="SemiBold"/>

                <Setter Property="Foreground"
                        Value="#0F172A"/>

            </Style>

            <!-- CARD STYLE -->

            <Style x:Key="CardStyle"
                   TargetType="Border">

                <Setter Property="Background"
                        Value="White"/>

                <Setter Property="CornerRadius"
                        Value="14"/>

                <Setter Property="Padding"
                        Value="20"/>

                <Setter Property="Margin"
                        Value="10"/>

                <Setter Property="BorderBrush"
                        Value="#E2E8F0"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>